# 🤖 v2 진행봇 — v2 서버에 WebSocket 으로 붙어 옛 봇(bot/announce.py)의 판단 · 문장을 그대로 쓴다(v2/tools/bot_v2.py).
#
# ⚠️ 옛 livemaster-bot 과 **같이 켜지 말 것** — 채팅에 모든 줄이 두 번 올라간다. 갈아타는 날 옛 것을 끄고 이것을 켠다.
# ⚠️ 열쇠(YT_CLIENT_ID · YT_CLIENT_SECRET · YT_REFRESH_TOKEN)가 없거나 v2 로그인이 틀리면 78 로 끝내고 되살리지 않는다.
# 로그인: BOT_V2_TOKEN → SESSION_SECRET(Bearer) → ADMIN_PASSWORD 순서(/etc/livemaster.env 에 이미 있는 것을 쓴다).

[Unit]
Description=진행봇 v2 (방송 사건 → 유튜브 라이브 채팅)
After=livemaster-v2.service network-online.target
Wants=network-online.target
Requires=livemaster-v2.service

[Service]
Type=simple
User=livemaster
WorkingDirectory=/opt/livemaster
EnvironmentFile=/etc/livemaster.env
Environment=BOT_V2_SERVER=http://127.0.0.1:5300
ExecStart=/opt/livemaster/.venv/bin/python -m v2.tools.bot_v2 --live
Restart=always
RestartSec=5
RestartPreventExitStatus=78
StandardOutput=journal
StandardError=journal
SyslogIdentifier=livemaster-bot-v2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
