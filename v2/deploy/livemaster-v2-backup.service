# 💾 v2 장부 백업 한 번 — livemaster-v2-backup.timer 가 매일 부른다.
#    ☁️ 바깥(Supabase 보관소)에도 올리기 — 스위치는 /etc/livemaster.env 의 LM2_BACKUP_UPLOAD=1 한 줄(이 파일은 안 고친다).
#       기본은 꺼짐(아래 0). EnvironmentFile 의 값이 Environment= 를 이기므로 env 파일에 1 을 넣으면 켜진다.
#       ⚠️ 먼저 Supabase → Storage 에 backups 버킷을 **비공개(Public 끔)** 로 만든다 — 없거나 공개면 올리지 않고 실패로 끝난다
#          (서버 안 백업은 그래도 남는다). 확인: sudo systemctl start livemaster-v2-backup && journalctl -u livemaster-v2-backup -n 5
[Unit]
Description=Live Master v2 장부 백업

[Service]
Type=oneshot
User=livemaster
WorkingDirectory=/opt/livemaster
EnvironmentFile=/etc/livemaster.env
Environment=LM2_DB=/opt/livemaster/v2/data/lm2.db
Environment=LM2_BACKUP_UPLOAD=0
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/livemaster/.venv/bin/python -m v2.tools.backup_db --keep 14
