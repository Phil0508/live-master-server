{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8777", "--bind", "127.0.0.1"],
      "port": 8777
    },
    {
      "name": "livemaster",
      "runtimeExecutable": "cmd",
